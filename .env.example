# Sealed Tip — environment variables (source of truth; ARCHITECTURE.md §13 points here).
# Never commit a filled-in .env.

# --- Network & contracts ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
SEALEDTIP_CONTRACT=sealedtip.<you>.testnet
TOKEN_CONTRACT=tusdc.<you>.testnet
SPUTNIK_FACTORY=sputnik-v2.testnet          # confirmed live 2026-11-05 (S-0.7); mainnet: sputnik-dao.near
PANEL_DAO=

# --- Accounts used by scripts ---
DEPLOYER_ACCOUNT=
DEPLOYER_PRIVATE_KEY=
OWNER_ACCOUNT=                              # defaults to DEPLOYER_ACCOUNT
FUNDER_ACCOUNT=                             # opens and funds the demo programme
DEPLOY_BUFFER_NEAR=0.5                      # headroom a deploy leaves above the storage bill

# --- Panel DAO (S-7.2): three real accounts, 2 of 3 votes appoint the reviewers ---
PANEL_DAO_NAME=sealedtip-panel              # the factory makes <name>.<SPUTNIK_FACTORY>
PANEL_1_ACCOUNT=
PANEL_2_ACCOUNT=
PANEL_3_ACCOUNT=
PANEL_1_X25519_SECRET=                      # 32 random bytes as hex; seed creates and stores these
PANEL_2_X25519_SECRET=
PANEL_3_X25519_SECRET=
PANEL_DAO_DISPLAY=Sealed Tip Review Panel
PANEL_DAO_PURPOSE=Appoints the reviewers who adjudicate Sealed Tip submissions
PROPOSAL_BOND_NEAR=1                        # what Sputnik 2.0.0's default policy locks to add a proposal

# --- Demo programme the seed script opens and funds ---
SEED_PROGRAMME_TITLE=Open-source audit bounty (demo)
SEED_SCOPE_URI=https://scope.example.org/audit-rules
SEED_MAX_REWARD_TUSDC=500
SEED_FUND_TUSDC=1000
SEED_GAS_DRIP_NEAR=0.05
SEED_OPS_NEAR=0.5                           # NEAR attached to create_programme: payouts' storage + gas
SEED_POW_BITS=12
SEED_TIME_SCALE=1                           # 1 = real time; the sandbox harness uses a compressed scale

# --- Relayers (apps/api) — function-call keys scoped to sealedtip ---
API_PORT=8787
# Where the tipster page is served from; without this the browser blocks every call to the API.
WEB_ORIGIN=http://localhost:3000
RELAYER_A_ACCOUNT=
RELAYER_A_KEY=
RELAYER_B_ACCOUNT=
RELAYER_B_KEY=
RELAY_DELAY_MIN_S=0                         # production 3600
RELAY_DELAY_MAX_S=20                        # production 86400
BLOB_STORE_URL=
BLOB_TOKEN=
BLOB_MAX_BYTES=26214400                     # 25 MB
# --- Deployment-only (empty = in-process demo store/queue) ---
# Vercel Blob read/write token: when set, ciphertext blobs live in Vercel Blob instead of process memory.
BLOB_READ_WRITE_TOKEN=
# Vercel KV (Upstash Redis) REST endpoint + token: when set, the relay queue is durable and a cron drains it.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Shared secret the Vercel Cron sends in its Authorization header, so only the cron can flush the queue.
CRON_SECRET=

# --- AI proxy (apps/api) ---
NEAR_AI_API_KEY=
NEAR_AI_MODEL=

# --- Keeper (apps/keeper) ---
KEEPER_ACCOUNT=
KEEPER_KEY=
KEEPER_X25519_SECRET=                     # 64 hex, written by `pnpm deploy:testnet -- --apply`
KEEPER_HEARTBEAT_S=300
KEEPER_WATCH_S=10                         # hard max 60: S-9.2 promises a triggered switch inside a minute
KEEPER_API_URL=http://localhost:8787      # the tip API: where the keeper reads its sealed key and writes re-sealed ones

# --- Web (apps/web) — public ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_SEALEDTIP_CONTRACT=sealedtip.<you>.testnet
# The NEP-141 token a programme's rewards are held in; the funder page shows this in its commands.
NEXT_PUBLIC_TOKEN_CONTRACT=tusdc.<you>.testnet
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Optional ---
ONECLICK_API_KEY=                         # gates POST /quote (S-8.6): empty means the route answers 503
